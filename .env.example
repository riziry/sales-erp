# Supabase Auth (recommended for this project)
AUTH_PROVIDER=supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Filled by db:setup-supabase for a linked, initially empty project:
SUPABASE_ALLOWED_USER_ID=
DATABASE_URL=

# Alternative local-only installation (no Supabase Auth):
# AUTH_PROVIDER=internal
# DATABASE_URL=postgresql://yw:yw_local_password@localhost:5432/yw_quotation
# ADMIN_EMAIL=admin@ywproduction.local
# ADMIN_PASSWORD=replace-with-a-long-random-password
